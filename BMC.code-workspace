{
  "folders": [
    {
      "name": "BMC",
      "path": "."
    },
    {
      "name": "ESP32",
      "path": "esp32"
    },
    {
      "name": "Oracle Server",
      "path": "oracle-server"
    },
    {
      "name": "PC Agent",
      "path": "pc-agent"
    },
    {
      "name": "Go Protocol",
      "path": "go-protocol"
    },
    {
      "name": "Frontend",
      "path": "frontend"
    },
  ],
  "settings": {
    // Hide component folders under BMC because each has its own workspace root.
    "files.exclude": {
      "esp32": true,
      "oracle-server": true,
      "frontend": true,
      "pc-agent": true,
      "go-protocol": true
    },
        "platformio-ide.toolbar": [
        {
            "text": "$(check)",
            "tooltip": "Build",
            "commands": "platformio-ide.build"
        },
        {
            "text": "$(arrow-up)",
            "tooltip": "Upload",
            "commands": "platformio-ide.upload"
        },
        {
            "text": "$(terminal)",
            "tooltip": "Tio Serial Monitor",
            "commands": [
                {
                    "id": "workbench.action.tasks.runTask",
                    "args": "Tio Serial Monitor"
                }
            ]
        }
    ]

  }
}